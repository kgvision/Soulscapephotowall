# Redis (shared live state — attendee feed, monitor, steward console).
# Auto-injected when you connect a Redis integration (e.g. Upstash) to this
# project from the Vercel dashboard's Storage tab. Without these set, the
# app falls back to an in-process in-memory store — fine for local dev, but
# NOT safe on Vercel in production (serverless functions don't share memory
# across instances, so different visitors would see different state).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (photo file storage). Connecting a Blob store to this project
# from the Storage tab injects either this token (older, manually-copied-
# token stores) or BLOB_STORE_ID (newer stores connected via "Connect
# Project", which authenticate over OIDC instead — app/api/photos/route.ts
# checks for either). Without one of these set, uploads fall back to writing
# into public/uploads/ on local disk — fine for local dev, but Vercel's
# serverless filesystem is read-only at runtime, so uploads WILL fail on a
# deployed instance without a store connected.
#
# The store also needs PUBLIC access enabled (Blob store → Settings): this
# app requests `access: "public"` on every upload because photos are shown
# via plain <img src> on the feed, monitor and steward console with no auth
# — a store created as private-only will reject every upload with
# "Cannot use public access on a private store."
BLOB_READ_WRITE_TOKEN=
